NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Required only for protected administrative operations such as role management.
# Never expose this value through a NUXT_PUBLIC_ variable or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Push delivery is disabled unless a backend adapter is installed.
# Keep provider credentials in the deployment secret manager, never in this file.
PUSH_PROVIDER=unconfigured
NUXT_PUBLIC_GALLERY_PROVIDER=web
NUXT_PUBLIC_GALLERY_URL=
NUXT_PUBLIC_CHURCH_WEBSITE_URL=https://ceda-app-beige.vercel.app
NUXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/igrejaceda/
NUXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@IgrejaCEDA
# Optional override of the official address in app/utils/officialContact.ts.
NUXT_PUBLIC_CHURCH_ADDRESS=
# Official reception contacts only; use country + area code (e.g. +55...) for phone/WhatsApp.
NUXT_PUBLIC_CHURCH_PHONE=
NUXT_PUBLIC_CHURCH_WHATSAPP=
NUXT_PUBLIC_CHURCH_EMAIL=
# Optional HTTPS map URL; otherwise Maps searches the configured church address.
NUXT_PUBLIC_CHURCH_MAP_URL=
